{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "gunicorn app:application --bind 0.0.0.0:$PORT"
  },
  "services": [
    {
      "name": "web",
      "startCommand": "gunicorn app:application --bind 0.0.0.0:$PORT --workers 1 --timeout 120"
    },
    {
      "name": "worker",
      "startCommand": "celery -A app:celery worker --loglevel=info --concurrency=1"
    },
    {
      "name": "scheduler",
      "startCommand": "celery -A app:celery beat --loglevel=info"
    }
  ]
}
