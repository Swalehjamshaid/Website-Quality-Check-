{
  "version": 2,
  "builds": [
    {
      "src": "qa_streamlit_api.py",  <-- CHANGE HERE
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/.*",
      "dest": "qa_streamlit_api.py"  <-- CHANGE HERE
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
