{
  "version": 2,
  "builds": [
    {
      "src": "wsgi.py",
      "use": "@vercel/python",
      "config": {
        // Explicitly set the start command to use gunicorn
        "runtime": "python3.9", // Or your desired Python version
        "maxLambdaSize": "30mb" 
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "wsgi.py"
    }
  ]
}
