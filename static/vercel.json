{
  "version": 2,
  "builds": [
    {
      "src": "wsgi.py", // Direct Vercel to the new entry point
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "30mb" // Allows for a larger deployment package
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "wsgi.py" // Route all web traffic through the WSGI entry point
    }
  ]
}
